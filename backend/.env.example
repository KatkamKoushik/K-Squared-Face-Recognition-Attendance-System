# ==============================================================================
# K² FRS — Environment Configuration Template
# ==============================================================================
# IMPORTANT: In production, all placeholders MUST be overridden with securely
# managed secrets. Missing production secrets fail closed at startup.
# ==============================================================================

# Environment Mode: development | staging | production | test
ENVIRONMENT=development
DEBUG=false
APP_NAME="K² FRS Control Plane"
API_V1_STR="/api/v1"

# Networking & Security Boundaries
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["*"]

# Authentication & Cryptography (FAIL-CLOSED IN PRODUCTION)
# Generate a strong 32-byte secret in production (e.g. `openssl rand -hex 32`)
SECRET_KEY=dev_insecure_secret_key_change_in_production_min_32_bytes_len
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Authoritative Database (PostgreSQL)
# Local Docker format: postgresql+psycopg2://postgres:postgres@localhost:5432/frs_db
# Cloud Supabase format: postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.hzqbgkdhxcnyakjjbjas.supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/frs_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_TIMEOUT_SECONDS=30

# Supabase Cloud Integration (Optional)
SUPABASE_URL=https://hzqbgkdhxcnyakjjbjas.supabase.co
SUPABASE_KEY=sb_publishable_-7c2WIgh_dbXIewd-7-BAA_EDWdSiqZ
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Fallback/Test SQLite Database (Used only when DATABASE_URL is not set or in testing)
TEST_DATABASE_URL=sqlite+aiosqlite:///./test_frs.db

# Storage & Image Retention Boundaries
# Shared frame storage path (shared volume between backend API and vision worker)
STORAGE_DIR=/data/frames
# Maximum image upload size in megabytes (default 50 MB)
MAX_UPLOAD_SIZE_MB=50
# Allowed MIME types for classroom capture frames
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png"]
MAX_IMAGE_WIDTH=16384
MAX_IMAGE_HEIGHT=16384
STRIP_EXIF_METADATA=true

# Vision Pipeline & Job Queue
JOB_LEASE_TIMEOUT_SECONDS=60
JOB_MAX_RETRIES=3
JOB_POLL_INTERVAL_SECONDS=2

# Supabase Cloud Integration
SUPABASE_URL=https://hzqbgkdhxcnyakjjbjas.supabase.co
SUPABASE_KEY=sb_publishable_-7c2WIgh_dbXIewd-7-BAA_EDWdSiqZ
SUPABASE_SECRET_KEY=
STRICT_CUDA_REQUIRED=false

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=text
REDACT_SENSITIVE_LOGS=true
