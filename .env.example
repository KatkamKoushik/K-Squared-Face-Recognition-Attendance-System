# ==============================================================================
# FRS V7.1 K² — Environment Configuration Template
# Copy this file to .env and provide your deployment-specific credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Authoritative Database & Cloud Supabase Tier
# ------------------------------------------------------------------------------
# Supabase PostgreSQL connection string (direct connection over port 5432)
# Format: postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.hzqbgkdhxcnyakjjbjas.supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_SUPABASE_POSTGRES_PASSWORD@db.hzqbgkdhxcnyakjjbjas.supabase.co:5432/postgres

# Supabase REST and Auth endpoints
NEXT_PUBLIC_SUPABASE_URL=https://hzqbgkdhxcnyakjjbjas.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_-7c2WIgh_dbXIewd-7-BAA_EDWdSiqZ
SUPABASE_URL=https://hzqbgkdhxcnyakjjbjas.supabase.co
SUPABASE_KEY=sb_publishable_-7c2WIgh_dbXIewd-7-BAA_EDWdSiqZ
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Local Docker PostgreSQL fallback (when running fully offline)
POSTGRES_DB=frs_k2
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. FastAPI Control Plane & Networking
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://k-squared-face-recognition-attendance-system-6rnfk44y10.vercel.app
ALLOWED_HOSTS=["localhost","127.0.0.1","straddle-deflate-footwear.ngrok-free.dev"]
SECRET_KEY=dev_insecure_secret_key_change_in_production_min_32_bytes_len
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
LOG_LEVEL=INFO
LOG_FORMAT=text
REDACT_SENSITIVE_LOGS=true

# ------------------------------------------------------------------------------
# 3. Next.js Admin Console Web Tier
# ------------------------------------------------------------------------------
# Point to remote tunnel in preview/production, or http://localhost:8000/api/v1 for local dev
NEXT_PUBLIC_API_URL=https://straddle-deflate-footwear.ngrok-free.dev/api/v1
NEXT_PUBLIC_APP_ENV=development
NODE_ENV=development
ADMIN_CONSOLE_PORT=3000

# ------------------------------------------------------------------------------
# 4. Flutter Teacher Mobile Client
# ------------------------------------------------------------------------------
# Compile-time dart define: --dart-define=API_URL=https://straddle-deflate-footwear.ngrok-free.dev/api/v1
API_URL=https://straddle-deflate-footwear.ngrok-free.dev/api/v1

