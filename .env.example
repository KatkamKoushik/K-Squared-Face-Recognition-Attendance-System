# ==============================================================================
# FRS V7.1 K² — Environment Configuration Template
# Copy this file to .env before starting the Docker Compose stack or local services.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Persistence Tier
# ------------------------------------------------------------------------------
POSTGRES_DB=frs_k2
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. FastAPI Control Plane & Vision Worker
# ------------------------------------------------------------------------------
# In Docker Compose, use host 'postgres'. For standalone local dev, use 'localhost'.
DATABASE_URL=postgresql+asyncpg://postgres:postgres_dev_password@postgres:5432/frs_k2
SECRET_KEY=dev_insecure_secret_key_change_in_production_min_32_bytes_len
ENVIRONMENT=development
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
LOG_FORMAT=text
REDACT_SENSITIVE_LOGS=true

# ------------------------------------------------------------------------------
# 3. Next.js Admin Console Web Tier
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NODE_ENV=development
ADMIN_CONSOLE_PORT=3000

# ------------------------------------------------------------------------------
# 4. Flutter Teacher Mobile Client (Compile-Time Settings)
# ------------------------------------------------------------------------------
# Android Emulator host loopback is 10.0.2.2. Physical devices use host LAN IP.
API_URL=http://10.0.2.2:8000/api/v1

# ------------------------------------------------------------------------------
# 5. Production CD Secrets (Configured in GitHub Repository Secrets)
# ------------------------------------------------------------------------------
# DEPLOY_WEBHOOK_URL=https://cloudrun.googleapis.com/...
# HOST_SSH_IP=192.168.1.100
# HOST_SSH_USER=deploy
# HOST_SSH_KEY="<base64-or-openssh-private-key>"
# KEYSTORE_BASE64=...
# KEYSTORE_PASSWORD=...
# KEY_ALIAS=...
# KEY_PASSWORD=...

