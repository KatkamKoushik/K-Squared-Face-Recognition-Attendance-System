# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Code files
*.py text eol=lf
*.dart text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.mako text eol=lf
*.sh text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
Dockerfile* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.onnx binary
*.jar binary
*.keystore binary
*.jks binary

